# Local development only. Copy to .env if you want overrides.
# Never commit real secrets. The compose file defaults are for localhost.

NORTHSTAR_DB_PASSWORD=northstar
NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:northstar@localhost:5432/northstar
NORTHSTAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
NORTHSTAR_LOG_LEVEL=INFO
NORTHSTAR_MAX_RETRIES=2
NORTHSTAR_LEASE_SECONDS=120
NORTHSTAR_POLL_INTERVAL_SECONDS=0.5
NORTHSTAR_WORKER_ID=
NORTHSTAR_MIGRATIONS_DIR=
VITE_API_BASE_URL=/api
